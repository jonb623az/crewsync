generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─── Company ────────────────────────────────────────────────────────────────
model Company {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?
  zip       String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  clients     Client[]
  properties  Property[]
  crews       Crew[]
  services    ServiceCatalog[]
  proposals   Proposal[]
  jobs        Job[]
  invoices    Invoice[]
  automations AutomationRule[]
  routes      RoutePlan[]
  messages    MessageLog[]
}

// ─── User + Roles ───────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String   @unique
  password  String
  role      String   @default("CREW_MEMBER")
  phone     String?
  avatarUrl String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  sessions        Session[]
  accounts        Account[]
  crewMemberships CrewMembership[]
  checkIns        CheckInOut[]
  assignedJobs    Job[]            @relation("AssignedJobs")
  proposals       Proposal[]       @relation("ProposalCreator")
  activityLogs    ActivityLog[]
  messages        MessageLog[]
}

// ─── NextAuth tables ────────────────────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ─── Client ─────────────────────────────────────────────────────────────────
model Client {
  id        String   @id @default(cuid())
  companyId String
  firstName String
  lastName  String
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zip       String?
  notes     String?
  tags      String?
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company      @relation(fields: [companyId], references: [id])
  properties Property[]
  invoices   Invoice[]
  messages   MessageLog[]
}

// ─── Property ───────────────────────────────────────────────────────────────
model Property {
  id          String   @id @default(cuid())
  companyId   String
  clientId    String
  name        String?
  address     String
  city        String
  state       String
  zip         String
  lat         Float?
  lng         Float?
  notes       String?
  accessNotes String?
  tags        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company      Company         @relation(fields: [companyId], references: [id])
  client       Client          @relation(fields: [clientId], references: [id])
  trees        Tree[]
  proposals    Proposal[]
  jobs         Job[]
  photos       PropertyPhoto[]
  activityLogs ActivityLog[]
}

// ─── Tree (first-class object) ──────────────────────────────────────────────
model Tree {
  id          String   @id @default(cuid())
  propertyId  String
  treeNumber  Int
  species     String?
  dbh         Float?
  heightEst   Float?
  lat         Float
  lng         Float
  status      String   @default("HEALTHY")
  riskRating  String   @default("LOW")
  healthNotes String?
  workNotes   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property      Property       @relation(fields: [propertyId], references: [id])
  photos        TreePhoto[]
  proposalItems ProposalItem[]
  jobTasks      JobTask[]

  @@unique([propertyId, treeNumber])
}

model TreePhoto {
  id       String   @id @default(cuid())
  treeId   String
  url      String
  type     String   @default("GENERAL")
  caption  String?
  takenAt  DateTime @default(now())
  tree     Tree     @relation(fields: [treeId], references: [id])
}

model PropertyPhoto {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  caption    String?
  takenAt    DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])
}

// ─── Service Catalog ────────────────────────────────────────────────────────
model ServiceCatalog {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String?
  unitPrice   Float   @default(0)
  unit        String  @default("each")
  taxable     Boolean @default(true)
  active      Boolean @default(true)

  company       Company        @relation(fields: [companyId], references: [id])
  proposalItems ProposalItem[]
}

// ─── Proposal ───────────────────────────────────────────────────────────────
model Proposal {
  id            String    @id @default(cuid())
  companyId     String
  propertyId    String
  createdById   String
  number        String    @unique
  status        String    @default("DRAFT")
  title         String?
  notes         String?
  internalNotes String?
  subtotal      Float     @default(0)
  taxRate       Float     @default(0)
  taxAmount     Float     @default(0)
  discount      Float     @default(0)
  total         Float     @default(0)
  validUntil    DateTime?
  sentAt        DateTime?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  signatureUrl  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company   Company        @relation(fields: [companyId], references: [id])
  property  Property       @relation(fields: [propertyId], references: [id])
  createdBy User           @relation("ProposalCreator", fields: [createdById], references: [id])
  items     ProposalItem[]
  jobs      Job[]
}

model ProposalItem {
  id          String  @id @default(cuid())
  proposalId  String
  serviceId   String?
  treeId      String?
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  total       Float   @default(0)
  notes       String?
  sortOrder   Int     @default(0)

  proposal Proposal        @relation(fields: [proposalId], references: [id])
  service  ServiceCatalog? @relation(fields: [serviceId], references: [id])
  tree     Tree?           @relation(fields: [treeId], references: [id])
}

// ─── Job ────────────────────────────────────────────────────────────────────
model Job {
  id             String    @id @default(cuid())
  companyId      String
  propertyId     String
  proposalId     String?
  assignedToId   String?
  number         String    @unique
  status         String    @default("UNSCHEDULED")
  title          String?
  instructions   String?
  clientNotes    String?
  internalNotes  String?
  scheduledDate  DateTime?
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  durationEst    Int?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company    Company      @relation(fields: [companyId], references: [id])
  property   Property     @relation(fields: [propertyId], references: [id])
  proposal   Proposal?    @relation(fields: [proposalId], references: [id])
  assignedTo User?        @relation("AssignedJobs", fields: [assignedToId], references: [id])
  tasks      JobTask[]
  checkIns   CheckInOut[]
  invoices   Invoice[]
}

model JobTask {
  id          String  @id @default(cuid())
  jobId       String
  treeId      String?
  description String
  completed   Boolean @default(false)
  sortOrder   Int     @default(0)

  job  Job   @relation(fields: [jobId], references: [id])
  tree Tree? @relation(fields: [treeId], references: [id])
}

// ─── Crew ───────────────────────────────────────────────────────────────────
model Crew {
  id        String @id @default(cuid())
  companyId String
  name      String
  color     String @default("#10b981")

  company Company          @relation(fields: [companyId], references: [id])
  members CrewMembership[]
}

model CrewMembership {
  id       String   @id @default(cuid())
  crewId   String
  userId   String
  isLeader Boolean  @default(false)
  joinedAt DateTime @default(now())

  crew Crew @relation(fields: [crewId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([crewId, userId])
}

model CheckInOut {
  id         String    @id @default(cuid())
  jobId      String
  userId     String
  checkedIn  DateTime  @default(now())
  checkedOut DateTime?
  lat        Float?
  lng        Float?
  notes      String?

  job  Job  @relation(fields: [jobId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

// ─── Invoice & Payment ──────────────────────────────────────────────────────
model Invoice {
  id         String    @id @default(cuid())
  companyId  String
  clientId   String
  jobId      String?
  number     String    @unique
  status     String    @default("DRAFT")
  subtotal   Float     @default(0)
  taxAmount  Float     @default(0)
  discount   Float     @default(0)
  total      Float     @default(0)
  amountPaid Float     @default(0)
  dueDate    DateTime?
  sentAt     DateTime?
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  client   Client    @relation(fields: [clientId], references: [id])
  job      Job?      @relation(fields: [jobId], references: [id])
  payments Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  method    String   @default("cash")
  reference String?
  paidAt    DateTime @default(now())
  notes     String?

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

// ─── Message Log ────────────────────────────────────────────────────────────
model MessageLog {
  id         String   @id @default(cuid())
  companyId  String
  clientId   String?
  userId     String?
  type       String
  direction  String   @default("OUTBOUND")
  to         String
  from       String
  subject    String?
  body       String
  status     String   @default("sent")
  externalId String?
  sentAt     DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id])
  client  Client?  @relation(fields: [clientId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
}

// ─── Automation Rules ───────────────────────────────────────────────────────
model AutomationRule {
  id        String  @id @default(cuid())
  companyId String
  name      String
  trigger   String
  action    String
  config    String
  active    Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id])
}

// ─── Route Plan ─────────────────────────────────────────────────────────────
model RoutePlan {
  id        String   @id @default(cuid())
  companyId String
  name      String
  date      DateTime
  stops     String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
}

// ─── Activity Log ───────────────────────────────────────────────────────────
model ActivityLog {
  id         String   @id @default(cuid())
  propertyId String?
  userId     String?
  action     String
  detail     String?
  createdAt  DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
}
